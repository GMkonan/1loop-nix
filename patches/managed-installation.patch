diff --git a/internal/update/managed_test.go b/internal/update/managed_test.go
new file mode 100644
--- /dev/null
+++ b/internal/update/managed_test.go
@@ -0,0 +1,47 @@
+// SPDX-License-Identifier: MPL-2.0
+
+package update
+
+import (
+	"context"
+	"net/http"
+	"net/http/httptest"
+	"sync/atomic"
+	"testing"
+)
+
+func TestManagedInstallation(t *testing.T) {
+	previous := Packaged
+	Packaged = "Nix"
+	t.Cleanup(func() { Packaged = previous })
+
+	var requests atomic.Int32
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		requests.Add(1)
+		http.Error(w, "unexpected update request", http.StatusServiceUnavailable)
+	}))
+	defer server.Close()
+	t.Setenv("ONELOOP_UPDATE_URL", server.URL)
+
+	// A managed build must not fetch a manifest, even on an explicit check.
+	ctx := context.Background()
+	status, manifest := Check(ctx, "desktop")
+	if status.Current != Version || status.Available || status.CanUpdate {
+		t.Fatalf("unexpected managed status: %+v", status)
+	}
+	if manifest.Version != "" {
+		t.Fatalf("expected no manifest for a managed update: %+v", manifest)
+	}
+
+	// Reject direct callers (including the server API) before downloading or
+	// touching the installation, not only by hiding the UI's update button.
+	for _, kind := range []string{"desktop", "server"} {
+		manifest := Manifest{Files: map[string]File{Platform(kind): {URL: server.URL + "/update.tar.gz"}}}
+		if binary, err := Install(ctx, manifest, kind); err == nil || binary != "" {
+			t.Fatalf("Install(%s) must refuse a managed update: binary=%q, error=%v", kind, binary, err)
+		}
+	}
+	if requests.Load() != 0 {
+		t.Fatalf("managed updates made %d network requests", requests.Load())
+	}
+}
