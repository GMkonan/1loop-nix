diff --git a/internal/update/managed_test.go b/internal/update/managed_test.go
new file mode 100644
index 0000000..b46663f
--- /dev/null
+++ b/internal/update/managed_test.go
@@ -0,0 +1,32 @@
+package update
+
+import (
+	"context"
+	"strings"
+	"testing"
+)
+
+func TestManagedInstallation(t *testing.T) {
+	previous := ManagedBy
+	ManagedBy = "Nix"
+	t.Cleanup(func() { ManagedBy = previous })
+
+	// A managed build must not fetch a manifest, even on an explicit check.
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	status, manifest := Check(ctx, "desktop")
+	if status.Current != Version || status.Available || status.CanUpdate {
+		t.Fatalf("unexpected managed status: %+v", status)
+	}
+	if status.Problem != managedProblem() || manifest.Version != "" {
+		t.Fatalf("expected package-manager guidance without fetching: %+v", status)
+	}
+
+	// Reject direct callers (including the server API) before downloading or
+	// touching the installation, not only by hiding the UI's update button.
+	for _, kind := range []string{"desktop", "server"} {
+		if _, err := Install(ctx, Manifest{}, kind); err == nil || !strings.Contains(err.Error(), "managed by Nix") {
+			t.Fatalf("Install(%s) must refuse a managed update: %v", kind, err)
+		}
+	}
+}
